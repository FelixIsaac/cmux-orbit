#!/usr/bin/env bun
import { existsSync, mkdirSync, readdirSync, statSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir, networkInterfaces } from "node:os";
import { join, resolve } from "node:path";
import { resolveCmuxSocketPath } from "../src/server/cmuxSocket";

const args = process.argv.slice(2);
const subcmd = args[0] || "start";
const portIdx = args.indexOf("--port");
const port =
  portIdx !== -1 && args[portIdx + 1]
    ? Number(args[portIdx + 1])
    : Number(process.env.PORT || 4400);

function detectTailscaleIp(): string | null {
  const nets = networkInterfaces();
  for (const entries of Object.values(nets)) {
    if (!entries) continue;
    for (const addr of entries) {
      if (addr.family === "IPv4" && !addr.internal) {
        const parts = addr.address.split(".").map((n) => parseInt(n, 10));
        if (parts[0] === 100 && parts[1] >= 64 && parts[1] <= 127) {
          return addr.address;
        }
      }
    }
  }
  return null;
}

function resolveStableBunPath(): string {
  const brewOptBun = "/opt/homebrew/opt/bun/bin/bun";
  if (existsSync(brewOptBun)) return brewOptBun;

  const intelBrewOptBun = "/usr/local/opt/bun/bin/bun";
  if (existsSync(intelBrewOptBun)) return intelBrewOptBun;

  try {
    const brewRes = Bun.spawnSync(["brew", "--prefix", "bun"]);
    if (brewRes.exitCode === 0) {
      const prefix = brewRes.stdout.toString().trim();
      const p = join(prefix, "bin/bun");
      if (existsSync(p)) return p;
    }
  } catch {}

  if (existsSync("/opt/homebrew/bin/bun")) return "/opt/homebrew/bin/bun";
  if (existsSync("/usr/local/bin/bun")) return "/usr/local/bin/bun";

  return process.execPath;
}

if (subcmd === "status") {
  const sock = resolveCmuxSocketPath();
  const tsIp = detectTailscaleIp();
  console.log(`✦ cmux-orbit status`);
  console.log(`  cmux.sock : ${sock} (${existsSync(sock) ? "✓ connected" : "✕ missing"})`);
  console.log(`  Local URL : http://127.0.0.1:${port} (loopback only)`);
  if (tsIp) {
    console.log(`  Tailscale : http://${tsIp}:${port} (via tailscale serve; not on LAN)`);
    console.log(`              <-- Open this on your iPhone (Add to Home Screen)`);
  }
  try {
    const res = await fetch(`http://127.0.0.1:${port}/api/dashboard`, {
      headers: { Connection: "close" },
    });
    const body = (await res.json()) as any;
    const snap = body.data;
    console.log(`  Daemon    : ✓ running on port ${port}`);
    console.log(
      `  Live State: ${snap.totalWorkspaces} workspaces, ${snap.totalSurfaces} surfaces (${snap.needsInputCount} needs input, ${snap.runningCount} running)`
    );
  } catch (err: any) {
    console.log(`  Daemon    : ✕ not reachable on port ${port} (${err?.message})`);
  }
  process.exit(0);
}

if (subcmd === "open") {
  const url = `http://localhost:${port}`;
  console.log(`Opening ${url} in default browser...`);
  Bun.spawn(["open", url]);
  process.exit(0);
}

if (subcmd === "logs") {
  const logDir = join(homedir(), ".local/state/cmux-orbit");
  const outFile = join(logDir, "orbit.out.log");
  const errFile = join(logDir, "orbit.err.log");
  const isFollow = args.includes("-f") || args.includes("--follow");

  if (!existsSync(outFile)) {
    console.log(`No logs found at ${outFile}`);
    process.exit(0);
  }

  if (isFollow) {
    console.log(`✦ Streaming live logs from ${outFile} (Ctrl-C to stop)...`);
    const proc = Bun.spawn(["tail", "-f", "-n", "50", outFile], {
      stdout: "inherit",
      stderr: "inherit",
    });
    await proc.exited;
  } else {
    const lines = args[1] && !args[1].startsWith("-") ? args[1] : "50";
    console.log(`✦ Last ${lines} lines of ${outFile}:`);
    const proc = Bun.spawn(["tail", "-n", lines, outFile], {
      stdout: "inherit",
      stderr: "inherit",
    });
    await proc.exited;

    if (existsSync(errFile) && statSync(errFile).size > 0) {
      console.log(`\n✦ Recent errors from ${errFile}:`);
      const errProc = Bun.spawn(["tail", "-n", "20", errFile], {
        stdout: "inherit",
        stderr: "inherit",
      });
      await errProc.exited;
    }
  }
  process.exit(0);
}

if (subcmd === "restart") {
  console.log("Restarting cmux-orbit service...");
  const uid = Bun.spawnSync(["id", "-u"]).stdout.toString().trim();
  const kickRes = Bun.spawnSync([
    "launchctl",
    "kickstart",
    "-k",
    `gui/${uid}/com.felix.cmux-orbit`,
  ]);

  if (kickRes.exitCode === 0) {
    console.log("✓ Successfully restarted com.felix.cmux-orbit");
  } else {
    // Fallback reload
    const plistPath = join(homedir(), "Library/LaunchAgents/com.felix.cmux-orbit.plist");
    if (existsSync(plistPath)) {
      Bun.spawnSync(["launchctl", "unload", plistPath]);
      Bun.spawnSync(["launchctl", "load", "-w", plistPath]);
      console.log("✓ Reloaded service via plist load");
    } else {
      console.log("✕ Service not installed. Run: ./bin/cmux-orbit install-service");
    }
  }
  process.exit(0);
}

if (subcmd === "doctor") {
  console.log("✦ cmux-orbit System & Health Diagnostics\n");

  // 1. Runtime
  console.log(`[1] Runtime`);
  const stableBun = resolveStableBunPath();
  console.log(`    Bun Version   : ${Bun.version} (${process.execPath})`);
  console.log(`    Stable Bun    : ${stableBun}`);
  console.log(`    Node Compat   : Node.js ${process.version}`);
  console.log(`    Platform      : ${process.platform} (${process.arch})`);

  // 2. cmux Socket
  console.log(`\n[2] cmux Connection`);
  const sock = resolveCmuxSocketPath();
  const sockExists = existsSync(sock);
  console.log(`    Socket Path   : ${sock}`);
  console.log(`    Socket Exists : ${sockExists ? "✓ Yes" : "✕ Not found (Is cmux running?)"}`);

  // 3. Network & Tailscale
  console.log(`\n[3] Network Configuration`);
  const tsIp = detectTailscaleIp();
  console.log(`    Tailscale IP  : ${tsIp ? `✓ ${tsIp}` : "✕ Not detected (Install/login Tailscale for remote iPhone access)"}`);
  console.log(`    Local Port    : ${port}`);
  console.log(`    Bind Host     : 127.0.0.1 (Loopback only; LAN access disabled)`);
  console.log(`    Tailscale Net : ${tsIp ? `http://${tsIp}:${port} via tailscale serve` : "inactive"}`);

  // 4. Daemon & HTTP Service
  console.log(`\n[4] Service Health`);
  const plistPath = join(homedir(), "Library/LaunchAgents/com.felix.cmux-orbit.plist");
  console.log(`    LaunchAgent   : ${existsSync(plistPath) ? "✓ Installed" : "✕ Not installed (Run ./bin/cmux-orbit install-service)"}`);

  try {
    const res = await fetch(`http://127.0.0.1:${port}/api/health`, {
      headers: { Connection: "close" },
      signal: AbortSignal.timeout(2000),
    });
    if (res.ok) {
      const data = (await res.json()) as any;
      console.log(`    HTTP API      : ✓ Responding 200 OK (Version: ${data.version || "1.0.0"})`);
      console.log(`    cmux Synced   : ${data.cmuxConnected ? "✓ Connected" : "✕ Disconnected"}`);
    } else {
      console.log(`    HTTP API      : ✕ HTTP ${res.status}`);
    }
  } catch (e: any) {
    console.log(`    HTTP API      : ✕ Unreachable on port ${port} (${e.message})`);
  }

  // 5. Media Cache
  console.log(`\n[5] Media Storage`);
  const mediaDir = "/tmp/cmux-orbit-media";
  if (existsSync(mediaDir)) {
    const files = readdirSync(mediaDir);
    let totalBytes = 0;
    for (const file of files) {
      try {
        totalBytes += statSync(join(mediaDir, file)).size;
      } catch {}
    }
    const mb = (totalBytes / (1024 * 1024)).toFixed(2);
    console.log(`    Media Cache   : ${files.length} items (${mb} MB in ${mediaDir})`);
  } else {
    console.log(`    Media Cache   : Directory empty / not yet created`);
  }

  // 6. Native Companions
  console.log(`\n[6] Native Companion Apps`);
  const macBin = join(resolve(import.meta.dir, ".."), "native/.build/out/Products/Debug/cmux-orbit-mac");
  console.log(`    macOS Binary  : ${existsSync(macBin) ? "✓ Built (native/.build/.../cmux-orbit-mac)" : "Not built yet (Run: cd native && swift build)"}`);

  console.log(`\n✓ Diagnostic complete.`);
  process.exit(0);
}

if (subcmd === "clean-media") {
  const mediaDir = "/tmp/cmux-orbit-media";
  if (!existsSync(mediaDir)) {
    console.log("No media directory found.");
    process.exit(0);
  }
  const files = readdirSync(mediaDir);
  const now = Date.now();
  const maxAgeMs = 24 * 60 * 60 * 1000; // 24 hours
  let deletedCount = 0;

  for (const file of files) {
    const filePath = join(mediaDir, file);
    try {
      const s = statSync(filePath);
      if (now - s.mtimeMs > maxAgeMs) {
        unlinkSync(filePath);
        deletedCount++;
      }
    } catch {}
  }
  console.log(`✓ Cleaned ${deletedCount} temporary media files older than 24h.`);
  process.exit(0);
}

if (subcmd === "install-service") {
  const home = homedir();
  const launchAgentsDir = join(home, "Library/LaunchAgents");
  mkdirSync(launchAgentsDir, { recursive: true });
  const plistPath = join(launchAgentsDir, "com.felix.cmux-orbit.plist");
  const repoRoot = resolve(import.meta.dir, "..");
  const bunPath = resolveStableBunPath();
  const logDir = join(home, ".local/state/cmux-orbit");
  mkdirSync(logDir, { recursive: true });

  const plistContent = `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.felix.cmux-orbit</string>
  <key>ProgramArguments</key>
  <array>
    <string>${bunPath}</string>
    <string>run</string>
    <string>${join(repoRoot, "src/server/index.ts")}</string>
  </array>
  <key>WorkingDirectory</key>
  <string>${repoRoot}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key>
    <string>${port}</string>
    <key>ORBIT_HOST</key>
    <string>127.0.0.1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>${join(logDir, "orbit.out.log")}</string>
  <key>StandardErrorPath</key>
  <string>${join(logDir, "orbit.err.log")}</string>
</dict>
</plist>
`;
  writeFileSync(plistPath, plistContent, "utf8");
  Bun.spawnSync(["launchctl", "unload", plistPath]);
  const loadRes = Bun.spawnSync(["launchctl", "load", "-w", plistPath]);
  const tsIp = detectTailscaleIp();
  console.log(`✓ Installed & started launchd service: ${plistPath} (bin: ${bunPath}, exit=${loadRes.exitCode})`);
  console.log(`  Local URL : http://127.0.0.1:${port} (loopback only)`);
  if (tsIp) {
    console.log(`  iPhone URL: http://${tsIp}:${port} (via tailscale serve; not on LAN)`);
  }
  process.exit(0);
}

if (subcmd === "uninstall-service") {
  const plistPath = join(homedir(), "Library/LaunchAgents/com.felix.cmux-orbit.plist");
  if (existsSync(plistPath)) {
    Bun.spawnSync(["launchctl", "unload", plistPath]);
    unlinkSync(plistPath);
    console.log(`✓ Removed launchd service: ${plistPath}`);
  } else {
    console.log(`No launchd service found at ${plistPath}`);
  }
  process.exit(0);
}

// Default: start server
const { startOrbitServer } = await import("../src/server/index");
const tsIp = detectTailscaleIp();
const { server } = startOrbitServer(port);
console.log(`✦ cmux-orbit running on http://${server.hostname}:${server.port} (loopback only)`);
if (tsIp) {
  console.log(`  📱 iPhone Tailscale URL: http://${tsIp}:${server.port} (via tailscale serve)`);
}
