{
  "name": "cmux-orbit",
  "version": "1.0.0",
  "description": "Agent-First Mobile Mission Control for cmux — Run Claude Code, Grok CLI, Codex, Pi, Antigravity & Shell natively from your phone over Tailscale.",
  "type": "module",
  "bin": {
    "cmux-orbit": "./bin/cmux-orbit"
  },
  "scripts": {
    "start": "bun run src/server/index.ts",
    "dev": "bun --watch run src/server/index.ts",
    "test": "bun test",
    "daemon:install": "bash scripts/install-launchd.sh",
    "daemon:restart": "launchctl kickstart -k gui/$(id -u)/com.felix.cmux-orbit",
    "daemon:status": "launchctl print gui/$(id -u)/com.felix.cmux-orbit",
    "daemon:uninstall": "launchctl bootout gui/$(id -u)/com.felix.cmux-orbit 2>/dev/null || true; rm -f ~/Library/LaunchAgents/com.felix.cmux-orbit.plist"
  },
  "keywords": [
    "cmux",
    "claude-code",
    "grok-cli",
    "codex",
    "pi",
    "tailscale",
    "mobile",
    "terminal-multiplexer",
    "ai-agents"
  ],
  "author": "Felix Isaac Lim <38658663+FelixIsaac@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ansi_up": "6.0.6",
    "marked": "18.1.1"
  }
}
